# ===== 数据库配置（改成你自己的 MySQL 账号密码） =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=ai_kb

# ===== 大模型配置（OpenAI 兼容接口，三选一填好即可） =====
# DeepSeek:    https://api.deepseek.com/v1                                 模型 deepseek-chat
# Kimi(月之暗面): https://api.moonshot.cn/v1                               模型 moonshot-v1-8k
# 通义千问:    https://dashscope.aliyuncs.com/compatible-mode/v1           模型 qwen-plus
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-在这里填你的APIKey
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# ===== 检索参数 =====
TOP_K=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50
